# Copy to .env in the repository root. Never commit real credentials.
APP_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=careerpilot_dev
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
VECTOR_STORE_URL=http://127.0.0.1:6333
VECTOR_STORE_API_KEY=
DEPENDENCY_TIMEOUT_SECONDS=1.5
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Only VITE_ values are public in the frontend. Never prefix secrets with VITE_.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional host ports for the LOCAL infrastructure Compose file.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
QDRANT_HOST_PORT=6333

# D Agent: choose model/region from YOUR provider console; no automatic free-model selection.
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=
AGENT_RESPONSE_FORMAT=json_object
AGENT_OUTPUT_TOKEN_PARAMETER=max_completion_tokens
# For compatible models requiring non-thinking JSON mode, uncomment:
# AGENT_ENABLE_THINKING=false
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_TOTAL_TIMEOUT_SECONDS=180
AGENT_MAX_ATTEMPTS=2
AGENT_MAX_REQUIREMENTS=8
AGENT_MAX_TOOL_CALLS=8
AGENT_TOP_K=5
AGENT_MAX_OUTPUT_TOKENS=4096

# Embedding and rerank belong to C, separate from the generation model above.
# EMBEDDING_API_KEY=
# RERANK_API_KEY=
