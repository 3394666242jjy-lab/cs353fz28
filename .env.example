# Copy to .env in the repository root. Never commit real credentials.
APP_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=careerpilot_dev
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
VECTOR_STORE_URL=http://127.0.0.1:6333
VECTOR_STORE_API_KEY=
# 向量库适配器（成员 C，issue #8）。在线/本地双模式切换只改前两项：
#   在线 Qdrant Cloud：VECTOR_STORE_URL 填集群 HTTPS 地址，VECTOR_STORE_API_KEY
#     填集群 Key；
#   本地开发：保持 http://127.0.0.1:6333（本仓库 compose.yaml 的 Qdrant 容器），
#     VECTOR_STORE_API_KEY 留空即不发鉴权头。
# 集合为可重建索引；dense 向量维度必须与 EMBEDDING_DIMENSION 一致，
# 切换环境不影响已约定的 payload 字段与过滤语义。
VECTOR_STORE_COLLECTION=careerpilot_chunks
VECTOR_STORE_TIMEOUT_SECONDS=10
VECTOR_STORE_MAX_RETRIES=2
VECTOR_STORE_RETRY_BACKOFF_SECONDS=0.5
DEPENDENCY_TIMEOUT_SECONDS=1.5
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Only VITE_ values are public in the frontend. Never prefix secrets with VITE_.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional host ports for the LOCAL infrastructure Compose file.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
QDRANT_HOST_PORT=6333

# Business/provider configuration is added by members B/C/D when implemented.
# Embedding 适配器（成员 C，issue #8）。OpenAI 兼容端点；换模型/服务商只改下面
# 四项，模型与维度随每次索引构建留档，M1 只用稠密向量：
#   在线：阿里云百炼 DashScope / OpenAI / 各类网关，必须填 EMBEDDING_API_KEY；
#   本地：Ollama / vLLM / Xinference 等自建 OpenAI 兼容端点，免鉴权，
#     EMBEDDING_API_KEY 留空（注意：更换导致维度变化须先重建 Qdrant 索引）。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
# 文档切分（成员 C，issue #8）。参数以 chunking_config_version 随索引留档；
# 检索对比实验前先在开发集上调定，再进共享评测。
CHUNK_MAX_CHARS=500
# 证据检索（成员 C，issue #8）。每次查询默认返回的候选片段数。
RETRIEVAL_TOP_K=5
# LLM_API_KEY=
# RERANK_API_KEY=
